{
  "manifest_version": 3,
  "name": "출결메이트",
  "version": "0.6.8",
  "description": "나이스 담임용 출결: 감지·대기열·라벨 기준 마감/P칸/저장. 출결마감·로그인 자동화 없음.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "webNavigation",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "출결메이트",
    "default_popup": "popup/popup.html"
  },
  "host_permissions": [
    "*://*.neis.go.kr/*",
    "http://localhost:5173/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.neis.go.kr/*"
      ],
      "js": [
        "content/detect.js",
        "content/filter-bar-parse.js",
        "content/row-match.js",
        "content/popup-apply.js",
        "content/neis-apply.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
